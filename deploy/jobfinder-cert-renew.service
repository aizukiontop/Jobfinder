[Unit]
Description=Renew the isolated JobFinder TLS certificate with lego
After=network-online.target jobfinder-nginx.service jobfinder-api.service
Wants=network-online.target
ConditionPathExists=/opt/jobfinder-public/bin/lego
ConditionPathExists=/opt/jobfinder-public/bin/renew-jobfinder-cert.sh

[Service]
Type=oneshot
ExecStart=/opt/jobfinder-public/bin/renew-jobfinder-cert.sh
ExecStopPost=/usr/bin/systemctl start jobfinder-api.service
TimeoutStartSec=10min
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

ReadOnlyPaths=/opt/jobfinder-public/bin /etc/jobfinder-nginx/nginx.conf /etc/jobfinder-nginx/site.conf /etc/nginx/mime.types -/opt/jobfinder-public/web
ReadWritePaths=/etc/jobfinder-nginx/tls /var/lib/jobfinder-letsencrypt /var/lib/jobfinder-nginx/acme
InaccessiblePaths=/etc/nginx/sites-available /etc/nginx/sites-enabled
InaccessiblePaths=/opt/jobfinder
InaccessiblePaths=/opt/igstprem /var/lib/mysql /var/backups/igst-restic /etc/igst-secrets

MemoryAccounting=true
MemoryHigh=40M
MemoryMax=56M
MemorySwapMax=0
OOMScoreAdjust=800
TasksMax=32
LimitNOFILE=256
CPUQuota=50%
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
