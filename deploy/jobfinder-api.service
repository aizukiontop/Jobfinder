[Unit]
Description=JobFinder isolated API
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=jobfinder
Group=jobfinder
WorkingDirectory=/opt/jobfinder/app
EnvironmentFile=/etc/jobfinder/jobfinder.env
ExecStart=/usr/bin/node /opt/jobfinder/app/server/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

# The process binds to 127.0.0.1:3210 through its environment file.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/jobfinder/data /opt/jobfinder/uploads
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallArchitectures=native
UMask=0077

# Continuous use must be measured before public enablement on the replica VPS.
MemoryHigh=68M
MemoryMax=76M
TasksMax=32

[Install]
WantedBy=multi-user.target
