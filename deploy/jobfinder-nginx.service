[Unit]
Description=JobFinder isolated Nginx frontend and API proxy
After=network-online.target jobfinder-api.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3
ConditionPathExists=/etc/jobfinder-nginx/nginx.conf
ConditionPathExists=/etc/jobfinder-nginx/site.conf

[Service]
Type=simple
SupplementaryGroups=jobfinder-web
RuntimeDirectory=jobfinder-nginx
RuntimeDirectoryMode=0755

ExecStartPre=/usr/sbin/nginx -t -q -p /var/lib/jobfinder-nginx/ -c /etc/jobfinder-nginx/nginx.conf
ExecStart=/usr/sbin/nginx -p /var/lib/jobfinder-nginx/ -c /etc/jobfinder-nginx/nginx.conf -g "daemon off;"
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -QUIT $MAINPID

Restart=on-failure
RestartSec=5s
TimeoutStartSec=15s
TimeoutStopSec=15s
KillMode=mixed
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET

CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETGID CAP_SETUID
AmbientCapabilities=
SocketBindDeny=any
SocketBindAllow=ipv4:tcp:80
SocketBindAllow=ipv4:tcp:443

ReadOnlyPaths=/etc/jobfinder-nginx /etc/nginx/mime.types -/opt/jobfinder-public/web
ReadWritePaths=/run/jobfinder-nginx /var/lib/jobfinder-nginx
InaccessiblePaths=/etc/nginx/sites-available /etc/nginx/sites-enabled
InaccessiblePaths=/opt/jobfinder
InaccessiblePaths=/opt/igstprem /var/lib/mysql /var/backups/igst-restic /etc/igst-secrets

MemoryAccounting=true
MemoryHigh=12M
MemoryMax=16M
MemorySwapMax=0
OOMScoreAdjust=800
TasksMax=16
LimitNOFILE=1024
CPUQuota=25%

[Install]
WantedBy=multi-user.target
