{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "node --watch server/index.js",
    "start:api": "node server/index.js",
    "db:migrate": "node server/cli/migrate.js",
    "db:seed": "node server/cli/seed.js",
    "test:api": "node --test --test-concurrency=1 server/test/*.test.js",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "better-sqlite3": "13.0.3",
    "cookie": "^1.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "file-type": "^21.1.1",
    "helmet": "^8.1.0",
    "leaflet": "^1.9.4",
    "multer": "^2.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "gh-pages": "^6.3.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
