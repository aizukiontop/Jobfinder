# The API must remain loopback-only behind Nginx.
JOBFINDER_HOST=127.0.0.1
JOBFINDER_PORT=3210
JOBFINDER_DB_PATH=/opt/jobfinder/data/jobfinder.sqlite
JOBFINDER_UPLOAD_DIR=/opt/jobfinder/uploads

# Set this to the final HTTPS website origin before enabling traffic.
# For local development, use the Vite origin (for example http://127.0.0.1:5173).
JOBFINDER_APP_ORIGIN=https://jobfinder.example.com

# Session durations in seconds.
JOBFINDER_SESSION_TTL=43200
JOBFINDER_REMEMBER_TTL=2592000

# Set to production on the VPS so Secure cookies are mandatory.
NODE_ENV=production

# Password reset link lifetime in seconds.
JOBFINDER_RESET_TTL=1800

# Email delivery for password resets. Set provider to "resend" and supply an API
# key to enable it; with "none" the reset endpoint accepts requests but sends
# nothing. JOBFINDER_MAIL_FROM must use a domain verified with the provider.
JOBFINDER_MAIL_PROVIDER=none
JOBFINDER_MAIL_API_KEY=
JOBFINDER_MAIL_FROM=JobFinder <no-reply@jobfinderangeles.site>
